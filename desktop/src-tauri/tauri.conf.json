{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scalp",
  "version": "10.6.0",
  "identifier": "com.scalp",

  "build": {
    "frontendDist": "frontend/build"
  },

  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["backend", "frontend/build"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      }
    }
  },

  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/anbu101/scalp-releases/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzRUUxQURDRUIxMzUxOTMKUldTVFVSUHIzQnJ1Z3hGODB6R2pYempSaDRMWUVFakRaM1A3YVN4M2VWMFBleGs1QkFRTnFscFgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scalp",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  }
}
