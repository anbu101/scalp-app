# ENGINE
# ════════════════════════════════════════════════════════════════════
from app.backtest.ic.ic_v1_engine import simulate_session, norm_leg, norm_adjust   # noqa: E402

T0 = 1_800_000_000 - (1_800_000_000 % 60)
E = T0 + 60                       # entry minute (fills at the T0 candle's close)


def C(ts, o, h=None, l=None, c=None):
    h = o if h is None else h
    l = o if l is None else l
    c = o if c is None else c
    return {"ts": ts, "open": o, "high": h, "low": l, "close": c}


LEGS = [norm_leg(x) for x in (
    {"id": "L1", "action": "SELL", "opt_type": "CE", "lots": 1, "premium_max": 85,
     "sl_val": 42, "sl_mode": "pct", "mtc_other_on_sl": True, "mtc_partner": "L2"},
    {"id": "L2", "action": "SELL", "opt_type": "PE", "lots": 1, "premium_max": 85,
     "sl_val": 42, "sl_mode": "pct", "mtc_other_on_sl": True, "mtc_partner": "L1"},
    {"id": "L3", "action": "BUY", "opt_type": "CE", "lots": 1, "premium_max": 6},
    {"id": "L4", "action": "BUY", "opt_type": "PE", "lots": 1, "premium_max": 6},
)]
SYMS = {"L1": "CE80", "L2": "PE80", "L3": "CE4", "L4": "PE4"}
N = 10                            # candles T0 … T0+9m


def base_candles():
    """L1 stops at E (high 120 ≥ 113.6); L2 re-pinned to cost from E+60 and
    scratched there (high 85 ≥ 80). Wings drift; distinct opens per minute."""
    c = {"L1": [C(T0, 80)] + [C(T0 + 60 * k, 80, 120 if k == 1 else 80, 80, 115 if k == 1 else 80)
                              for k in range(1, N)],
         "L2": [C(T0, 80), C(E, 75, 76, 70, 72), C(E + 60, 72, 85, 70, 84)]
               + [C(T0 + 60 * k, 84) for k in range(3, N)],
         "L3": [C(T0 + 60 * k, 4.0 - 0.1 * k) for k in range(N)],
         "L4": [C(T0 + 60 * k, 4.0 + 0.2 * k) for k in range(N)]}
    return c


def run(cands, *, on, legs=LEGS, **kw):
    kw.setdefault("exit_mode", "NEXT_OPEN")
    return simulate_session([dict(l) for l in legs], {k: list(v) for k, v in cands.items()},
                            dict(SYMS), E, None, hedge_close_when_flat=on, **kw)


def rows(r):
    return {t["leg"]: t for t in r["trades"]}


def engine_tests():
    print("── engine")
    # 0101
    r = run(base_candles(), on=True)
    t = rows(r)
    check("TC-ICHF-0101 shorts out: L1 SL, L2 MTC_COST",
          t["L1"]["exit_reason"] == "SL" and t["L2"]["exit_reason"] == "MTC_COST", {k: v["exit_reason"] for k, v in t.items()})
    due = t["L2"]["exit_ts"] + 60
    check("TC-ICHF-0101 wings sold HEDGE_FLAT at the next candle's OPEN",
          all(t[w]["exit_reason"] == "HEDGE_FLAT" and t[w]["exit_ts"] == due for w in ("L3", "L4"))
          and t["L3"]["exit_price"] == round(4.0 - 0.1 * 3, 10) and t["L4"]["exit_price"] == 4.0 + 0.2 * 3,
          [(t[w]["exit_ts"] - T0, t[w]["exit_price"]) for w in ("L3", "L4")])
    check("TC-ICHF-0101 nothing carried; flag counts 2",
          r["carry_out"] == {} and r["flags"]["hedge_flat_closes"] == 2, (r["carry_out"].keys(), r["flags"].get("hedge_flat_closes")))
    # 0102
    r0 = run(base_candles(), on=False)
    check("TC-ICHF-0102 OFF: wings carry overnight, no HEDGE_FLAT flag",
          set(r0["carry_out"]) == {"L3", "L4"} and "hedge_flat_closes" not in r0["flags"]
          and {x["leg"] for x in r0["trades"]} == {"L1", "L2"})

    # 0103 adjustments
    adj_cfg = {"L1": norm_adjust({"enabled": True, "lots": 1, "premium_max": 85, "sl_val": 30, "tp_val": 100}),
               "L2": norm_adjust({"enabled": True, "lots": 1, "premium_max": 85, "sl_val": 30, "tp_val": 100})}
    a1 = [C(T0 + 60 * k, 60) for k in range(N)]
    a1[4] = C(T0 + 240, 60, 125, 60, 121)             # L1A TP (120) at +4m
    a2 = [C(T0 + 60 * k, 60) for k in range(N)]
    a2[6] = C(T0 + 360, 60, 60, 40, 41)               # L2A SL (42) at +6m
    picks = {"L1": {"symbol": "CEA", "strike": 1, "expiry": "x", "candles": a1},
             "L2": {"symbol": "PEA", "strike": 2, "expiry": "x", "candles": a2}}
    r = run(base_candles(), on=True, adjust_on_sl=True, adjust_cfg=adj_cfg, adjust_picks=picks, adjust_fill="open")
    t = rows(r)
    check("TC-ICHF-0103 both ·ADJ legs opened and closed (TP / SL)",
          t.get("L1A", {}).get("exit_reason") == "TP" and t.get("L2A", {}).get("exit_reason") == "SL",
          {k: v["exit_reason"] for k, v in t.items()})
    last = max(t["L1A"]["exit_ts"], t["L2A"]["exit_ts"])
    check("TC-ICHF-0103 wings kept while an ·ADJ leg was open/pending, sold the minute after the last one",
          all(t[w]["exit_reason"] == "HEDGE_FLAT" and t[w]["exit_ts"] == last + 60 for w in ("L3", "L4")),
          [(t[w]["exit_reason"], t[w]["exit_ts"] - T0) for w in ("L3", "L4")])
    r0 = run(base_candles(), on=False, adjust_on_sl=True, adjust_cfg=adj_cfg, adjust_picks=picks, adjust_fill="open")
    check("TC-ICHF-0103 ·ADJ rows identical ON vs OFF",
          [x for x in r["trades"] if x["is_adjust"]] == [x for x in r0["trades"] if x["is_adjust"]])

    # 0104 pending adjustment dropped (no strike for L1; L2 disabled)
    adj2 = {"L1": adj_cfg["L1"], "L2": norm_adjust({"enabled": False, "lots": 1})}
    r = run(base_candles(), on=True, adjust_on_sl=True, adjust_cfg=adj2, adjust_picks={}, adjust_fill="open")
    t = rows(r)
    l1_act = t["L1"]["exit_ts"] + 60
    want = max(l1_act, t["L2"]["exit_ts"]) + 60
    check("TC-ICHF-0104 adjustment dropped (no strike) → wings sold the minute after",
          r["flags"]["adjust_no_strike"] >= 1
          and all(t[w]["exit_reason"] == "HEDGE_FLAT" and t[w]["exit_ts"] == want for w in ("L3", "L4")),
          (r["flags"]["adjust_no_strike"], [(t[w]["exit_reason"], t[w]["exit_ts"] - T0) for w in ("L3", "L4")], want - T0))

    # 0105 wing has no candle at the sell minute
    c = base_candles()
    c["L3"] = [x for x in c["L3"] if x["ts"] != T0 + 180]
    r = run(c, on=True)
    t = rows(r)
    check("TC-ICHF-0105 wing without a candle at the sell minute → its next candle's OPEN",
          t["L3"]["exit_reason"] == "HEDGE_FLAT" and t["L3"]["exit_ts"] == T0 + 240
          and t["L3"]["exit_price"] == 4.0 - 0.1 * 4 and t["L4"]["exit_ts"] == T0 + 180,
          (t["L3"]["exit_ts"] - T0, t["L3"]["exit_price"]))

    # 0106 synthetic wing
    c = base_candles()
    c["L4"] = []
    ov = {"L4": {"price": 4.25, "symbol": "SYN-PE", "strike": 3, "expiry": "x", "synthetic": True, "synth_kind": "wing"}}
    r = run(c, on=True, entry_overrides=ov)
    t = rows(r)
    check("TC-ICHF-0106 synthetic wing booked HEDGE_FLAT at the sell minute at its own mark",
          t["L4"]["exit_reason"] == "HEDGE_FLAT" and t["L4"]["exit_ts"] == T0 + 180
          and t["L4"]["exit_price"] == 4.25 and t["L4"]["synthetic"],
          (t["L4"]["exit_reason"], t["L4"]["exit_ts"] - T0, t["L4"]["exit_price"]))

    # 0107 last short leaves on the final candle
    c = base_candles()
    for k in ("L1", "L2", "L3", "L4"):
        c[k] = [x for x in c[k] if x["ts"] <= E + 60]       # session ends at E+60
    r = run(c, on=True)
    t = rows(r)
    check("TC-ICHF-0107 last short on the final candle → wings sold at the last mark, not carried",
          r["carry_out"] == {} and all(t[w]["exit_reason"] == "HEDGE_FLAT" and t[w]["exit_ts"] == E + 60
                                       and t[w]["exit_price"] == c[w][-1]["close"] for w in ("L3", "L4")),
          (list(r["carry_out"]), [(t.get(w, {}).get("exit_reason"), t.get(w, {}).get("exit_ts", 0) - T0) for w in ("L3", "L4")]))

    # 0108 one short still open
    c = base_candles()
    c["L2"] = [C(T0, 80)] + [C(T0 + 60 * k, 50) for k in range(1, N)]   # L2 in profit, never back to cost
    r = run(c, on=True)
    check("TC-ICHF-0108 a short still open → wings carry with it",
          set(r["carry_out"]) == {"L2", "L3", "L4"} and r["flags"]["hedge_flat_closes"] == 0,
          (list(r["carry_out"]), r["flags"].get("hedge_flat_closes")))

    # 0109 carry day + hard-close day
    carry_in = {lid: {"leg": l, "entry_price": 4.0 if l["action"] == "BUY" else 80.0,
                      "sl": None, "tp": None, "mtc_applied": False, "last_close": 4.0, "last_ts": T0 - 86400,
                      "entry_ts": T0 - 86400, "symbol": SYMS[lid], "is_adjust": False, "adjust_of": None,
                      "synthetic": False, "synth_kind": None, "watch_from": 0}
                for lid, l in ((x["id"], x) for x in LEGS) if lid in ("L3", "L4")}
    cc = {k: v for k, v in base_candles().items() if k in ("L3", "L4")}
    kw = dict(carry_in=carry_in, next_open_ts=T0 + 60, is_carry_day=True)
    a = simulate_session([], {k: list(v) for k, v in cc.items()}, dict(SYMS), E, None, exit_mode="NEXT_OPEN",
                         hedge_close_when_flat=True, **kw)
    b = simulate_session([], {k: list(v) for k, v in cc.items()}, dict(SYMS), E, None, exit_mode="NEXT_OPEN",
                         hedge_close_when_flat=False, **kw)
    check("TC-ICHF-0109 carry day: switch has no effect (NEXT_OPEN close)",
          a["trades"] == b["trades"] and all(x["exit_reason"] == "NEXT_OPEN" for x in a["trades"]))
    r = run(base_candles(), on=True, hard_close_ts=T0 + 480, hard_close_reason="EOD")
    r0 = run(base_candles(), on=False, hard_close_ts=T0 + 480, hard_close_reason="EOD")
    check("TC-ICHF-0109 expiry day: wings sold HEDGE_FLAT early (OFF: EOD close)",
          all(rows(r)[w]["exit_reason"] == "HEDGE_FLAT" and rows(r)[w]["exit_ts"] == T0 + 180 for w in ("L3", "L4"))
          and all(rows(r0)[w]["exit_reason"] == "EOD" for w in ("L3", "L4")))

    # 0110 OFF ≡ ORIGINAL engine
    bak = HERE.parent / f"ic_v1_engine.py.bak-{FENCE}"
    if not bak.exists():
        print(f"  note: {bak.name} not found — OFF ≡ ORIGINAL (engine) skipped (the apply script provides it)")
        return
    orig = _load(bak, "ic_v1_engine_orig_hf")
    scen = [dict(), dict(adjust_on_sl=True, adjust_cfg=adj_cfg, adjust_picks=picks, adjust_fill="open"),
            dict(adjust_on_sl=True, adjust_cfg=adj2, adjust_picks={}), dict(hard_close_ts=T0 + 480, hard_close_reason="EOD")]
    same = True
    for sc in scen:
        for cset in (base_candles(), c):
            x = run(cset, on=False, **sc)
            y = orig.simulate_session([dict(l) for l in LEGS], {k: list(v) for k, v in cset.items()}, dict(SYMS), E, None,
                                      exit_mode="NEXT_OPEN", **sc)
            same &= (x == y)
    leg_eod = simulate_session([dict(l) for l in LEGS], base_candles(), dict(SYMS), E, T0 + 480)
    leg_eod0 = orig.simulate_session([dict(l) for l in LEGS], base_candles(), dict(SYMS), E, T0 + 480)
    check("TC-ICHF-0110 OFF ≡ ORIGINAL engine on every scenario (trades, carry_out, flags)",
          same and leg_eod == leg_eod0)


