# RUNNER
# ════════════════════════════════════════════════════════════════════
def runner_tests():
    print("── runner")
    xn = _load(HERE.parent / "test_ic2_expiry_next.py", "ic_xn_helpers_hf")
    from app.utils.market_hours import is_trading_day
    import app.backtest.data.candle_source as _cs
    from app.backtest.ic.backtest_ic_runner import run_ic_backtest as NEW

    td = tempfile.mkdtemp()
    atexit.register(lambda: shutil.rmtree(td, ignore_errors=True))
    days, d = [], date(2026, 1, 12)
    while len(days) < 30:
        if is_trading_day(d):
            days.append(d)
        d += timedelta(days=1)
    dbp = os.path.join(td, "bt.db")
    xn.build_corpus(dbp, days, seed=47)
    _cs._backtest_db_path = lambda: Path(dbp)
    D0, D1 = days[1], days[-2]

    def run_(cfg, sid="IC_V2", fn=None):
        r = (fn or NEW)(db_path=dbp, strategy_id=sid, underlying="NIFTY", date_from=D0, date_to=D1,
                        config_override=cfg)
        assert not r.get("aborted"), r.get("reason")
        return r

    V2 = {"entry_time": "09:18", "exit_mode": "NEXT_OPEN", "next_open_time": "09:16",
          "expiry_exit_time": "15:28", "adjust_on_sl": True, "adjust_delay_s": 60, "adjust": xn.ADJ,
          "legs": xn.legs()}
    diag = lambda r: r["summary"].get("diag_ic", {})
    K = lambda r, pred=lambda t: True: sorted(xn.key(t) for t in r["trades"] if pred(t))
    is_wing = lambda t: t.direction == "BUY" and "·ADJ" not in (t.condition or "")
    day = lambda ts: (datetime(1970, 1, 1) + timedelta(seconds=int(ts) + IST)).date()

    off = run_(V2)
    bak = HERE.parent / f"backtest_ic_runner.py.bak-{FENCE}"
    if bak.exists():
        orig = _load(bak, "ic_runner_orig_hf")
        o = run_(V2, fn=orig.run_ic_backtest)
        check("TC-ICHF-0111 key absent ≡ ORIGINAL runner row-for-row", K(off) == K(o))
        check("TC-ICHF-0111 …same diag keys", set(diag(off)) == set(diag(o)), set(diag(off)) ^ set(diag(o)))
    else:
        print(f"  note: {bak.name} not found — OFF ≡ ORIGINAL (runner) skipped (the apply script provides it)")
    f = run_({**V2, "hedge_close_when_flat": False})
    check("TC-ICHF-0111 false ≡ absent", K(f) == K(off) and set(diag(f)) == set(diag(off)))

    on = run_({**V2, "hedge_close_when_flat": True})
    hf = [t for t in on["trades"] if t.exit_reason == "HEDGE_FLAT"]
    check("corpus exercises the rule (some HEDGE_FLAT wings)", len(hf) >= 2, len(hf))
    check("TC-ICHF-0112 shorts + ·ADJ rows ≡ OFF row-for-row", K(on, lambda t: not is_wing(t)) == K(off, lambda t: not is_wing(t)))
    check("TC-ICHF-0112 only wings carry HEDGE_FLAT", all(is_wing(t) for t in hf))

    by_day: dict = {}
    for t in on["trades"]:
        by_day.setdefault(day(t.entry_ts), []).append(t)
    ok_timing, ok_alone, bad = True, True, []
    for dd, ts_ in by_day.items():
        others = [t for t in ts_ if not is_wing(t)]
        wings = [t for t in ts_ if is_wing(t)]
        if not others or not wings:
            continue
        last = max(t.exit_ts for t in others)
        for w in wings:
            if w.exit_reason == "HEDGE_FLAT":
                if not (w.exit_ts <= last + 60 and day(w.exit_ts) == dd):
                    ok_timing = False
                    bad.append((dd, w.condition, w.exit_ts - last))
            elif day(w.exit_ts) > dd and all(day(t.exit_ts) == dd for t in others):
                ok_alone = False          # wing carried overnight while its condor was flat
                bad.append((dd, w.condition, "carried alone"))
    check("TC-ICHF-0113 every HEDGE_FLAT wing leaves within a minute of its condor's last leg, same day",
          ok_timing, bad[:5])
    check("TC-ICHF-0113 no wing carried overnight alone", ok_alone, bad[:5])
    dg = diag(on)
    check("TC-ICHF-0114 diag hedge_flat_closes = HEDGE_FLAT rows; days counted",
          dg.get("hedge_close_when_flat") is True and dg.get("hedge_flat_closes") == len(hf)
          and 1 <= dg.get("hedge_flat_days", 0) <= len(hf), {k: dg.get(k) for k in ("hedge_flat_closes", "hedge_flat_days")})
    V1 = {"entry_time": "09:18", "exit_time": "15:28", "legs": xn.legs()}
    a, b = run_(V1, "IC_V1"), run_({**V1, "hedge_close_when_flat": True}, "IC_V1")
    check("TC-ICHF-0114 IC_V1 (EOD) ignores the key", K(a) == K(b) and set(diag(a)) == set(diag(b)))
    print(f"  (info) HEDGE_FLAT wings: {len(hf)}; net OFF {off['summary']['net_pnl']} → ON {on['summary']['net_pnl']}")


def main():
    engine_tests()
    runner_tests()
    print(f"\n{OK[0]} passed, {len(FAILS)} failed")
    if FAILS:
        print("FAILED:", FAILS)
        sys.exit(1)
    print("ALL IC2 HEDGE-FLAT CHECKS PASSED")


if __name__ == "__main__":
    main()
