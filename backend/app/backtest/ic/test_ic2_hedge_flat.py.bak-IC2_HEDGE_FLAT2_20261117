# backend/app/backtest/ic/test_ic2_hedge_flat.py — fence IC2_HEDGE_FLAT_20261117
#
# IC_V2 backtest: hedge_close_when_flat. Once every short and ·ADJ leg is closed
# and no adjustment is pending, the BUY wings L3/L4 are sold at the OPEN of the
# next 1m candle (reason HEDGE_FLAT) instead of riding alone to the expiry close
# or the next morning.
#   engine  TC-ICHF-0101  both shorts out (SL → MTC_COST), no adjustment → wings sold
#                         at the next candle's OPEN, nothing carried
#           TC-ICHF-0102  OFF → wings carry overnight exactly as before
#           TC-ICHF-0103  an ·ADJ leg open (or pending) keeps the wings; sold the
#                         minute after the last ·ADJ leg closes
#           TC-ICHF-0104  pending adjustment that is dropped (no strike) → wings sold
#                         the minute after the drop
#           TC-ICHF-0105  wing without a candle at the sell minute → its next candle
#           TC-ICHF-0106  synthetic wing (no candles) → booked at the sell minute
#           TC-ICHF-0107  last short leaves on the session's final candle → sold at the
#                         last mark, not carried
#           TC-ICHF-0108  a short still open → wings carry with it (unchanged)
#           TC-ICHF-0109  carry day ignores the switch; expiry (hard-close) day sells the
#                         wings early instead of at the EOD close
#           TC-ICHF-0110  OFF ≡ the ORIGINAL engine (.bak) on every scenario
#   runner  TC-ICHF-0111  key absent ≡ ORIGINAL runner (.bak) row-for-row, same diag keys;
#                         false ≡ absent
#           TC-ICHF-0112  ON: shorts and ·ADJ rows ≡ OFF row-for-row; only wings move
#           TC-ICHF-0113  ON: every HEDGE_FLAT wing leaves one minute after its condor's
#                         last other leg (or at session end); no wing carried alone
#           TC-ICHF-0114  ON: diag hedge_flat_closes / hedge_flat_days match the rows;
#                         IC_V1 (EOD) ignores the key
# Synthetic data only; never touches backtest.db.
# Run: cd backend && python3 app/backtest/ic/test_ic2_hedge_flat.py
from __future__ import annotations

import atexit
import importlib.util
import os
import shutil
import sys
import tempfile
from datetime import date, datetime, timedelta
from pathlib import Path

HERE = Path(__file__).resolve()
BACKEND = str(HERE.parents[3])
if BACKEND not in sys.path:
    sys.path.insert(0, BACKEND)
os.environ.setdefault("SCALP_LOT_SIZE_OFFLINE", "1")

FENCE = "IC2_HEDGE_FLAT_20261117"
FAILS: list = []
OK = [0]
IST = 5 * 3600 + 30 * 60


def check(name, ok, note=""):
    print(f"  {'PASS' if ok else 'FAIL'}  {name}{('  — ' + str(note)) if (note and not ok) else ''}")
    if ok:
        OK[0] += 1
    else:
        FAILS.append(name)


def _load(path: Path, name: str):
    from importlib.machinery import SourceFileLoader
    spec = importlib.util.spec_from_loader(name, SourceFileLoader(name, str(path)))
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


