OH, OL = 110.0, 100.0


def run_sig(extra, **kw):
    d = {}
    kw.setdefault("orb_minutes", 15)
    kw.setdefault("tf_minutes", 5)
    sig = orb_signals(ORB_WINDOW + extra, day_start_epoch=DS,
                      orb_high=OH, orb_low=OL, diag=d, **kw)
    return sig, d


