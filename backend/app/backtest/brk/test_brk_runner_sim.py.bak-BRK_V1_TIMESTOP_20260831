def ts(minute):
    return DS + minute * 60


SCHEMA = """
CREATE TABLE backtest_candles_1m (
  ts INTEGER, tradingsymbol TEXT, underlying TEXT, instrument_type TEXT,
  strike REAL, expiry TEXT, open REAL, high REAL, low REAL, close REAL,
  volume INTEGER DEFAULT 0, oi INTEGER DEFAULT 0
);
CREATE INDEX i1 ON backtest_candles_1m(tradingsymbol, ts);
CREATE INDEX i2 ON backtest_candles_1m(underlying, instrument_type, ts);
"""


def series(sym, strike, itype, base, overrides=None, m0=555, m1=917, skip=()):
    """Flat contract at `base` every minute m0..m1-1, with per-minute
    (o,h,l,c) overrides. Minutes in `skip` have NO print."""
    rows = []
    for m in range(m0, m1):
        if m in skip:
            continue
        o, h, l, c = (overrides or {}).get(m, (base, base, base, base))
        rows.append((sym, strike, itype, m, o, h, l, c))
    return rows


def build(rows, expiry=EXPIRY):
    fh = tempfile.NamedTemporaryFile(suffix=".db", delete=False)
    fh.close()
    c = sqlite3.connect(fh.name)
    c.executescript(SCHEMA)
    for m in range(555, 917):
        c.execute("INSERT INTO backtest_candles_1m(ts,tradingsymbol,underlying,"
                  "instrument_type,open,high,low,close) VALUES(?,?,?,?,?,?,?,?)",
                  (ts(m), "NIFTY-SPOT", "NIFTY", "SPOT", 25000, 25000, 25000, 25000))
    for sym, strike, itype, m, o, h, l, cl in rows:
        c.execute("INSERT INTO backtest_candles_1m(ts,tradingsymbol,underlying,"
                  "instrument_type,strike,expiry,open,high,low,close) "
                  "VALUES(?,?,?,?,?,?,?,?,?,?)",
                  (ts(m), sym, "NIFTY", itype, strike, expiry.isoformat(),
                   o, h, l, cl))
    c.commit()
    c.close()
    return fh.name


def run(db, cfg=None, day=DAY):
    return run_brk_backtest(db_path=db, strategy_id="BRK_V1",
                            underlying="NIFTY", date_from=day, date_to=day,
                            config_override=cfg or {})


def net_long(entry, exit_, qty=LOT):
    return round((exit_ - entry) * qty
                 - charges_for_long_trade(entry_price=entry, exit_price=exit_,
                                          qty=qty).total_charges, 2)


