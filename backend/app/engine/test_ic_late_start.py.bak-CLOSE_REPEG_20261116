# test_ic_late_start.py — PREMARKET_0914_20261116 / PREMARKET_FIRED_KEEP_20261116
# Icarus carries legs overnight (NEXT_OPEN). Their stop GTTs now stay armed
# until 09:14; the app may also start late (after 09:15), or Kite may be
# logged in late. Whatever the start time, each carried leg must be closed
# exactly ONCE: a stop that already fired is booked from its own order,
# never bought / sold again — also on a strike another strategy shares.
# Real Icarus group manager on the fleet's fake Kite account (test_fleet_live).
#   PYTHONPATH=backend python3 backend/app/engine/test_ic_late_start.py
import contextlib
import io
import os
import sys
from datetime import datetime
from pathlib import Path

ROOT = str(Path(__file__).resolve().parents[2])
sys.path.insert(0, ROOT)
sys.path.insert(0, ROOT + "/app/engine")
os.environ.setdefault("SCALP_TEST_MODE", "1")

with contextlib.redirect_stdout(io.StringIO()):
    import test_fleet_live as F                                    # noqa: E402

PASSED, FAILS = [0], []
S, W_CE, W_PE, ADJ = F.S_IC_PE, F.W_IC_CE, F.W_IC_PE, F.sym(25450, "CE")


def check(name, cond, detail=""):
    if cond:
        PASSED[0] += 1
        print(f"[ok  ] {name}")
    else:
        FAILS.append(name)
        print(f"[MISS] {name}\n         -> {detail}")


def quiet(fn, *a, **k):
    with contextlib.redirect_stdout(io.StringIO()):
        return fn(*a, **k)


def carry(shared):
    """13 Nov: Icarus L1 stopped, L2 at cost, L1A bought, carried overnight
    (L2 short 24950 PE −195 with its stop GTT, L1A long with its stop GTT,
    both wings). shared: Tigris still holds −130 of the same 24950 PE."""
    def build():
        f = F.t_icarus_sl_with_tigris_on_same_strike()
        if not shared:
            f.ts.square_off_all("EOD")
        f.t2.kill_close(f.ts_of(15, 25))
        f.now = datetime(2026, 11, 13, 15, 31, tzinfo=F.IST)
        assert f.ic.commit_carry("LIVE")
        f.kite.market_open = False
        f2 = F.Fleet(kite=f.kite, tmp=f.tmp, restore=True)
        assert f2.ic.restore_carry_payload(F.ic_carry_store.load_carry("IC_V2"))
        f2.vet.resume_from_db()
        return f2
    f2 = quiet(build)
    return f2, f2.kite


def gtt(k, s):
    return next(g for g in k.gtts.values() if g["symbol"] == s and g["status"] == "active")


def other(k):
    return -130 if k.net.get(S, 0) < -195 else 0


def square_off(f2, n=6):
    rem = None
    for _ in range(n):
        rem = quiet(f2.ic.morning_square_off)
        if rem == 0:
            break
    return rem


def end_state(f2, k, label, sh, s_buys0, adj_sells0):
    tag = "shared" if sh else "sole"
    L = f2.ic_legs()
    check(f"{label} [{tag}]: every carried leg closed, group closed",
          all(l.state != F.L_OPEN for l in L.values()) and f2.ic.current_group().state == F.G_CLOSED,
          str({i: l.state for i, l in L.items()}))
    check(f"{label} [{tag}]: 24950 PE short bought back exactly once (195)",
          f2.buys(S) - s_buys0 == 195, f"bought {f2.buys(S) - s_buys0}")
    check(f"{label} [{tag}]: the other strategy's 24950 PE is untouched",
          k.net.get(S, 0) == (-130 if sh else 0), f"net {k.net.get(S, 0)}")
    check(f"{label} [{tag}]: L1A long sold exactly once (195)",
          f2.sells(ADJ) - adj_sells0 == 195 and k.net.get(ADJ, 0) == 0,
          f"sold {f2.sells(ADJ) - adj_sells0}, net {k.net.get(ADJ, 0)}")
    check(f"{label} [{tag}]: wings sold, no GTT armed, nothing working",
          k.net.get(W_CE, 0) == 0 and k.net.get(W_PE, 0) == 0 and not k.active_gtts()
          and not k.open_orders(), f"{k.active_gtts()} {k.open_orders()}")
    ok, d = f2.audit_quiet()
    check(f"{label} [{tag}]: broker positions == what the strategies hold", ok, d)


for sh in (False, True):
    # ── LS1: app off overnight AND through the open, starts 09:25 ─────────────
    f2, k = carry(sh)
    k.market_open = True
    b0, a0 = f2.buys(S), f2.sells(ADJ)
    check(f"LS1 [{'shared' if sh else 'sole'}]: overnight stops still armed at Kite when the app starts at 09:25",
          len(k.active_gtts()) == 2)
    check("LS1: 09:25 square-off completes", square_off(f2) == 0)
    end_state(f2, k, "LS1 start 09:25, stops never fired", sh, b0, a0)

    # ── LS2: 24950 PE stop fires 09:15:05; app (or Kite login) at 09:15:30 ─────
    f2, k = carry(sh)
    k.market_open = True
    b0, a0 = f2.buys(S), f2.sells(ADJ)
    k.set_px(S, 99.0)
    k.tick()
    k.tick()
    check(f"LS2 [{'shared' if sh else 'sole'}]: the broker's stop bought back Icarus's 195 at 09:15:05",
          f2.buys(S) - b0 == 195)
    check("LS2: 09:15:30 teardown reports nothing armed", quiet(f2.ic.premarket_cancel_gtts) is True
          and all(g["symbol"] != S for g in k.active_gtts()))
    check("LS2: the fired stop is kept on L2 for the square-off",
          bool(f2.ic.leg_runtime("L2").get("gtt_ids")))
    check("LS2: 09:16 square-off completes", square_off(f2) == 0)
    end_state(f2, k, "LS2 stop fired in the first candle, start 09:15:30", sh, b0, a0)

    # ── LS3: stop fires 09:20 while the app is down; app starts 09:40 ─────────
    f2, k = carry(sh)
    k.market_open = True
    b0, a0 = f2.buys(S), f2.sells(ADJ)
    k.set_px(S, 100.0)
    k.tick()
    k.tick()
    check("LS3: 09:40 square-off completes", square_off(f2) == 0)
    end_state(f2, k, "LS3 stop fired 09:20, start 09:40", sh, b0, a0)

    # ── LS4: gap through the stop — its limit order rests unfilled ────────────
    for start in ("09:15:30", "09:25"):
        f2, k = carry(sh)
        k.market_open = True
        b0, a0 = f2.buys(S), f2.sells(ADJ)
        g = gtt(k, S)
        k.set_px(S, g["limit"] + 8)              # above the stop's limit
        k.tick()
        check(f"LS4 [{start}]: the stop fired, its buy rests unfilled",
              f2.buys(S) - b0 == 195 and any(o["tradingsymbol"] == S for o in k.open_orders()))
        if start == "09:15:30":
            quiet(f2.ic.premarket_cancel_gtts)
        k.set_px(S, g["limit"] - 1)              # the market comes back to it
        rem = square_off(f2)
        k.tick()
        rem = square_off(f2) if rem else rem
        check(f"LS4 [{start}]: square-off completes", rem == 0, str(rem))
        end_state(f2, k, f"LS4 gap, resting stop order, start {start}", sh, b0, a0)

    # ── LS5: L1A's (long) stop fires in the first candle ──────────────────────
    f2, k = carry(sh)
    k.market_open = True
    b0, a0 = f2.buys(S), f2.sells(ADJ)
    g = gtt(k, ADJ)
    k.set_px(ADJ, (g["trigger"] + g["limit"]) / 2)
    k.tick()
    k.tick()
    check("LS5: the broker's stop sold L1A's 195", f2.sells(ADJ) - a0 == 195)
    quiet(f2.ic.premarket_cancel_gtts)
    check("LS5: 09:16 square-off completes", square_off(f2) == 0)
    end_state(f2, k, "LS5 long's stop fired in the first candle", sh, b0, a0)

    # ── LS6: app starts 09:25, Kite not logged in yet, login at 09:31 ─────────
    f2, k = carry(sh)
    k.market_open = True
    k.logged_in = False
    b0, a0 = f2.buys(S), f2.sells(ADJ)
    n0 = len(k.events)
    rem = square_off(f2, n=3)
    check("LS6: before the login nothing is sent or booked; legs stay open",
          rem > 0 and len(k.events) == n0 and all(l.state == F.L_OPEN for l in f2.ic_legs().values()),
          f"rem {rem}")
    k.logged_in = True
    k.set_px(S, 99.0)                            # and the stop fired meanwhile
    k.tick()
    k.tick()
    for _l in ("L2", "L1A", "L3", "L4"):         # the stuck-leg backoff passes
        f2.ic._rt.get(_l, {}).pop("exit_retry_at", None)
    check("LS6: after the 09:31 login the square-off completes", square_off(f2) == 0)
    end_state(f2, k, "LS6 late login, stop fired meanwhile", sh, b0, a0)

    # ── LS7: stop fired 09:20, app starts 09:40 — the GTT monitor's sweep and
    #         the square-off both run (either order) ─────────────────────────
    for first in ("monitor", "square-off"):
        f2, k = carry(sh)
        k.market_open = True
        b0, a0 = f2.buys(S), f2.sells(ADJ)
        k.set_px(S, 100.0)
        k.tick()
        k.tick()
        f2.ic.set_carry_hold(False)
        if first == "monitor":
            quiet(f2.ic_sweep, 2)
            rem = square_off(f2)
        else:
            rem = quiet(f2.ic.morning_square_off)
            quiet(f2.ic_sweep, 2)
            rem = square_off(f2)
        quiet(f2.ic_sweep, 2)
        check(f"LS7 [{first} first]: square-off completes", rem == 0, str(rem))
        end_state(f2, k, f"LS7 start 09:40, {first} first", sh, b0, a0)

print(f"\n{PASSED[0]} passed, {len(FAILS)} failed")
if FAILS:
    sys.exit(1)
print("ALL LATE-START CHECKS PASSED")
