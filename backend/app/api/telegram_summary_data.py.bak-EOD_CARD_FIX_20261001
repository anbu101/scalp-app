# ── EOD_CARD_V2_20260929 ── fleet MTM path (read-only, fail-open) ───

def _fleet_paths(now: int | None = None) -> dict:
    """Today's per-book fleet MTM path, {"LIVE": [[minute, gross], …],
    "PAPER": […]}, built from fleet_mtm_samples exactly as the Modern
    dashboard draws it: _read_paths() for the day, _book_paths() for the
    forward-filled per-book sum over the "<SID>:<BOOK>" row keys. Legacy
    "__LIVE__"/"__PAPER__" keys (no longer written) are ignored. Books with
    no samples are omitted; any failure yields {} and the card renders
    without the chart lines."""
    try:
        from app.api import fleet_today_routes as _fl
        now = int(now or time.time())
        raw = _fl._read_paths(now)
        keys = [k for k in raw if ":" in k and k.rsplit(":", 1)[1] in _fl.BOOKS]
        rows = [{"key": k, "book": k.rsplit(":", 1)[1], "state": "OPEN"} for k in keys]
        paths = _fl._book_paths(raw, rows)
        return {b: p for b, p in paths.items() if p}
    except Exception as e:
        write_audit_log(f"[CARD][MTM] fleet path read failed: {e}")
        return {}


def _subtitle(now: datetime) -> str:
    # "Mon 21 Sep 2026 · 15:30 IST" — the scheduler fires at 15:30 IST; the
    # process clock is the Mac's local clock, which is IST on Anbu's machines.
    return now.strftime("%a %d %b %Y") + " \u00b7 " + now.strftime("%H:%M") + " IST"


def build_card_data() -> CardData:
    now = datetime.now()
    return CardData(
        date_str=now.strftime("%d %b %Y"),
        live_rows=_live_rows(),
        paper_rows=_paper_rows(),
        subtitle=_subtitle(now),        # ── EOD_CARD_V2_20260929 ──
        mtm_paths=_fleet_paths(),       # ── EOD_CARD_V2_20260929 ──
    )