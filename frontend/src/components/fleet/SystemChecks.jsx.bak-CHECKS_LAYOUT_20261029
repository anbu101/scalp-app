/* frontend/src/components/fleet/SystemChecks.jsx — ── SYSTEM_CHECKS_UI_20261029 ──
   Dashboard strip for the two background safety jobs (admin only):

     Broker check  (BROKER_RECON_20261029)  GET /api/recon/status every 15 s.
                   All clear → one quiet line. Open issues → the card turns
                   amber/red and lists each one: what the broker holds, what
                   the app expects, which strategies. ORPHAN / QTY rows offer
                   "Mark as manual" (two-step, no browser dialog — Tauri's
                   webview has none); marked positions are listed and can be
                   unmarked. "Check now" runs one poll (read-only).
     Data recorder (DATA_RECORDER_20261029) GET /api/recorder/status every 60 s.
                   Today's grade, last pull, backup place; an inline field
                   sets the off-Mac backup folder.

   Every request failing with 403 (standard licence) or 404 (backend without
   the patch) hides that line; the strip renders nothing when both are hidden. */
import React, { useCallback, useEffect, useRef, useState } from "react";
import { getApiBase } from "../../api/base";
import { colors, spacing } from "../../tokens";
import { stratName } from "../../strategies/displayNames";

const KIND_TEXT = {
  ORPHAN: "No strategy holds this position",
  GHOST: "The app holds this position, the broker is flat",
  QTY: "Quantities differ",
};

const hhmmss = (ts) => (ts ? new Date(ts * 1000).toLocaleTimeString("en-IN", { hour12: false, timeZone: "Asia/Kolkata" }) : "—");
const signed = (q) => (q > 0 ? `+${q}` : q < 0 ? `−${Math.abs(q)}` : "0");

async function api(path, method = "GET", body) {
  const r = await fetch(`${getApiBase()}${path}`, {
    method, headers: { "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined,
  });
  const j = await r.json().catch(() => ({}));
  if (!r.ok) { const e = new Error(j.detail || `HTTP ${r.status}`); e.status = r.status; throw e; }
  return j;
}

function Dot({ color }) {
  return <i aria-hidden="true" style={{ width: 8, height: 8, borderRadius: "50%", background: color, display: "inline-block", flex: "0 0 auto" }} />;
}

function SmallBtn({ children, onClick, disabled, tone }) {
  const bg = tone === "warn" ? colors.warning : colors.bg.tertiary;
  const fg = tone === "warn" ? "#fff" : colors.text.primary;
  return (
    <button type="button" onClick={onClick} disabled={disabled}
      style={{ padding: "4px 10px", borderRadius: 6, border: `1px solid ${colors.border.light}`, background: bg, color: fg,
               fontSize: 12, fontWeight: 600, cursor: disabled ? "default" : "pointer", opacity: disabled ? 0.6 : 1, whiteSpace: "nowrap" }}>
      {children}
    </button>
  );
}

function IssueRow({ iss, isAdminUi, meta, onMark, busy }) {
  const [arm, setArm] = useState(false);
  const t = useRef(null);
  useEffect(() => () => clearTimeout(t.current), []);
  let who = {};
  try { who = JSON.parse(iss.strategies || "{}") || {}; } catch { who = {}; }
  const names = Object.entries(who).map(([sid, q]) => `${stratName(sid, isAdminUi, meta?.[sid]?.name)} ${signed(q)}`).join(", ");
  const expected = iss.app_qty + iss.ignored_qty;
  const extra = iss.broker_qty - expected;                      // what a "manual" mark would cover
  // A manual mark only explains EXTRA broker quantity in the same direction
  // (an orphan, or more than the strategies hold). Less at the broker than
  // the app expects (partial exit / missing fill) is never "manual".
  const canMark = iss.kind === "ORPHAN" || (iss.kind === "QTY" && extra !== 0 &&
    Math.sign(extra) === Math.sign(iss.broker_qty) && Math.abs(iss.broker_qty) > Math.abs(expected));
  const tone = iss.kind === "GHOST" ? colors.loss : colors.warning;
  const click = () => {
    if (!arm) { setArm(true); clearTimeout(t.current); t.current = setTimeout(() => setArm(false), 5000); return; }
    setArm(false); onMark(iss.symbol, extra);
  };
  return (
    <div style={{ display: "flex", alignItems: "center", gap: spacing.md, flexWrap: "wrap", padding: `${spacing.sm}px 0`,
                  borderTop: `1px solid ${colors.border.light}` }}>
      <span style={{ fontSize: 11, fontWeight: 700, color: tone, border: `1px solid ${tone}`, borderRadius: 4, padding: "1px 6px" }}>{iss.kind}</span>
      <span style={{ fontFamily: "var(--c-font-mono, monospace)", fontSize: 13, fontWeight: 600 }}>{iss.symbol}</span>
      <span style={{ fontSize: 12.5, color: colors.text.secondary, flex: "1 1 260px", minWidth: 0 }}>
        {KIND_TEXT[iss.kind]}: broker <b>{signed(iss.broker_qty)}</b>, app expects <b>{signed(expected)}</b>
        {names ? <> ({names})</> : null}
        {iss.ignored_qty ? <>, of which {signed(iss.ignored_qty)} marked manual</> : null}. Since {hhmmss(iss.confirmed_at)}.
      </span>
      {canMark && (
        <SmallBtn tone={arm ? "warn" : undefined} disabled={busy} onClick={click}>
          {arm ? `Confirm: ${signed(extra)} is manual` : "Mark as manual"}
        </SmallBtn>
      )}
    </div>
  );
}

export default function SystemChecks({ isAdminUi, meta, compact }) {
  const [recon, setRecon] = useState(null);       // null = loading, false = hidden
  const [rec, setRec] = useState(null);
  const [busy, setBusy] = useState(false);
  const [msg, setMsg] = useState("");
  const [showMarks, setShowMarks] = useState(false);
  const [folder, setFolder] = useState("");
  const [editFolder, setEditFolder] = useState(false);

  const loadRecon = useCallback(async () => {
    try { setRecon(await api("/api/recon/status")); }
    catch (e) { setRecon((p) => (e.status === 403 || e.status === 404 ? false : (p || { error: e.message }))); }
  }, []);
  const loadRec = useCallback(async () => {
    try { setRec(await api("/api/recorder/status?days=3")); }
    catch (e) { setRec((p) => (e.status === 403 || e.status === 404 ? false : (p || { error: e.message }))); }
  }, []);
  useEffect(() => {
    if (!isAdminUi) return undefined;
    loadRecon(); loadRec();
    const a = setInterval(loadRecon, 15000), b = setInterval(loadRec, 60000);
    return () => { clearInterval(a); clearInterval(b); };
  }, [isAdminUi, loadRecon, loadRec]);

  const act = async (fn, ok) => {
    setBusy(true); setMsg("");
    try { await fn(); if (ok) setMsg(ok); } catch (e) { setMsg(`Failed: ${e.message}`); }
    finally { setBusy(false); loadRecon(); }
  };
  const checkNow = () => act(async () => {
    const r = await api("/api/recon/run", "POST");
    if (r && r.ok === false) throw new Error(r.error || "check failed");
    if (r && r.ran === false) throw new Error(r.reason || "not run");
  }, "Checked just now.");
  const mark = (symbol, qty) => act(() => api("/api/recon/ignore", "POST", { tradingsymbol: symbol, qty, note: "marked on Dashboard" }),
                                    `${symbol} ${signed(qty)} marked as manual.`);
  const unmark = (id) => act(() => api(`/api/recon/ignore/${id}`, "DELETE"), "Mark removed.");
  const saveFolder = async () => {
    setBusy(true); setMsg("");
    try { await api("/api/recorder/settings", "POST", { backup_dir: folder.trim() }); setEditFolder(false); setMsg("Backup folder saved."); await loadRec(); }
    catch (e) { setMsg(`Not saved: ${e.message}`); } finally { setBusy(false); }
  };

  if (!isAdminUi || (recon === false && rec === false)) return null;

  const issues = recon?.open_issues || [];
  const marks = recon?.ignores || [];
  const last = recon?.last_run;
  const ghost = issues.some((i) => i.kind === "GHOST");
  const reconColor = !recon ? colors.text.muted : issues.length ? (ghost ? colors.loss : colors.warning)
    : last && !last.ok ? colors.warning : colors.success;
  const reconText = !recon ? "Broker check: loading…"
    : recon.error ? `Broker check unavailable (${recon.error})`
    : issues.length ? `Broker check: ${issues.length} position${issues.length > 1 ? "s" : ""} differ from Zerodha`
    : !last ? "Broker check: no check yet today"
    : last.ok ? `Broker check: matches Zerodha · checked ${hhmmss(last.ts)}`
    : `Broker check: last check failed at ${hhmmss(last.ts)} (${last.error || "error"})`;

  const today = (rec?.days || [])[0];
  const off = rec?.backup_off_machine;
  const recColor = !rec ? colors.text.muted : rec.error || rec.last_error ? colors.warning
    : !off ? colors.warning : colors.success;
  const recText = !rec ? "Recorder: loading…"
    : rec.error ? `Recorder unavailable (${rec.error})`
    : !rec.exists ? "Recorder: nothing recorded yet"
    : `Recorder: ${today ? `${today.day} ${today.quality || "—"}${today.last_pull_at ? ` · last pull ${hhmmss(today.last_pull_at)}` : ""}` : "no days yet"}`
      + (rec.last_error ? ` · ${rec.last_error}` : "");

  const pad = compact ? `${spacing.sm}px ${spacing.md}px` : `${spacing.sm + 2}px ${spacing.lg}px`;
  return (
    <section aria-label="Safety checks" style={{ background: colors.bg.secondary, borderRadius: 8, padding: pad,
      border: `1px solid ${issues.length ? reconColor : colors.border.light}`, boxShadow: "0 1px 3px var(--c-shadow)",
      display: "flex", flexDirection: "column", gap: spacing.xs, minWidth: 0 }}>

      {recon !== false && (
        <div style={{ display: "flex", alignItems: "center", gap: spacing.sm, flexWrap: "wrap", minWidth: 0 }}>
          <Dot color={reconColor} />
          <span role="status" style={{ fontSize: 13, fontWeight: issues.length ? 700 : 500, color: issues.length ? reconColor : colors.text.primary,
                                       flex: "1 1 220px", minWidth: 0 }}>{reconText}</span>
          {marks.length > 0 && (
            <SmallBtn onClick={() => setShowMarks((s) => !s)}>{showMarks ? "Hide manual" : `Manual (${marks.length})`}</SmallBtn>
          )}
          <SmallBtn onClick={checkNow} disabled={busy}>{busy ? "Checking…" : "Check now"}</SmallBtn>
        </div>
      )}

      {issues.map((iss) => <IssueRow key={iss.id} iss={iss} isAdminUi={isAdminUi} meta={meta} onMark={mark} busy={busy} />)}

      {showMarks && marks.map((m) => (
        <div key={m.id} style={{ display: "flex", alignItems: "center", gap: spacing.md, flexWrap: "wrap", fontSize: 12.5,
                                 color: colors.text.secondary, padding: `${spacing.xs}px 0`, borderTop: `1px solid ${colors.border.light}` }}>
          <span style={{ fontFamily: "var(--c-font-mono, monospace)", color: colors.text.primary }}>{m.symbol}</span>
          <span>{signed(m.qty)} manual{m.note ? ` · ${m.note}` : ""}. Clears itself when the broker is flat.</span>
          <span style={{ marginLeft: "auto" }}><SmallBtn onClick={() => unmark(m.id)} disabled={busy}>Unmark</SmallBtn></span>
        </div>
      ))}

      {rec !== false && (
        <div style={{ display: "flex", alignItems: "center", gap: spacing.sm, flexWrap: "wrap", minWidth: 0 }}>
          <Dot color={recColor} />
          <span style={{ fontSize: 13, color: colors.text.primary, flex: "1 1 220px", minWidth: 0 }}>
            {recText}
            {rec && rec.exists !== undefined && !rec.error && (
              <span style={{ color: off ? colors.text.secondary : colors.warning }}>
                {" · "}{off ? "backup off this Mac" : "backup only on this Mac"}
              </span>
            )}
          </span>
          {rec && !rec.error && !editFolder && (
            <SmallBtn onClick={() => { setFolder(off ? rec.backup_dir || "" : ""); setEditFolder(true); }}>
              {off ? "Backup folder" : "Set backup folder"}
            </SmallBtn>
          )}
        </div>
      )}
      {editFolder && (
        <div style={{ display: "flex", gap: spacing.sm, flexWrap: "wrap", alignItems: "center" }}>
          <input aria-label="Backup folder" value={folder} onChange={(e) => setFolder(e.target.value)}
            placeholder="~/Library/Mobile Documents/com~apple~CloudDocs/ScalpRecorder"
            style={{ flex: "1 1 320px", minWidth: 0, padding: "6px 10px", borderRadius: 6, border: `1px solid ${colors.border.light}`,
                     background: colors.bg.input, color: colors.text.primary, fontSize: 12.5 }} />
          <SmallBtn onClick={saveFolder} disabled={busy || !folder.trim()}>Save folder</SmallBtn>
          <SmallBtn onClick={() => setEditFolder(false)} disabled={busy}>Cancel</SmallBtn>
        </div>
      )}

      {msg && <div style={{ fontSize: 12, color: msg.startsWith("Failed") || msg.startsWith("Not saved") ? colors.loss : colors.text.secondary }}>{msg}</div>}
    </section>
  );
}
