/**
 * usePageVisibility — src/hooks/usePageVisibility.js
 *
 * ── PAGE_VISIBILITY_20261117 ── Backtest, Crypto Lab and TV Alerts are
 * hidden by default for EVERY user (admin included). A user turns a page on
 * under Settings → App Settings → Pages. Stored in app_settings.json as
 * settings.pages = { backtest, crypto_lab, tv_alerts } (absent / not true = off).
 *
 * Visibility = entitled (unchanged admin gate, see App.jsx UI_MASK) AND on.
 * A route whose page is off lands on the Dashboard, like a non-entitled one.
 */
import { useAppSettings } from "../context/NotificationProvider";
import { useEntitlements } from "./useEntitlements";

// ── CRYPTO_LAB_OPEN ── TEMPORARY: true opens the lab to ALL licensed users.
// Must match CRYPTO_LAB_OPEN_TO_ALL in api_server.py (backend gate), or
// non-admins see the page but every call 403s. REVERT: false in both places.
// (moved here from App.jsx by PAGE_VISIBILITY_20261117 — single definition)
export const CRYPTO_LAB_OPEN_TO_ALL = true;

export const OPTIONAL_PAGES = [
  { key: "backtest",   path: "/backtest",   label: "Backtest",   icon: "🧪", adminOnly: true,
    desc: "Strategy backtests, sweeps, compare and portfolio." },
  { key: "crypto_lab", path: "/crypto-lab", label: "Crypto Lab", icon: "🪙", adminOnly: !CRYPTO_LAB_OPEN_TO_ALL,
    desc: "BTC options and perp research lab." },
  { key: "tv_alerts",  path: "/tv-alerts",  label: "TV Alerts",  icon: "📡", adminOnly: true,
    desc: "TradingView-alert paper trades." },
];

const BY_PATH = Object.fromEntries(OPTIONAL_PAGES.map((p) => [p.path, p]));

/** true only for an explicit `true` — absent, null or anything else is off. */
export function pageEnabled(settings, key) {
  const pages = settings && typeof settings.pages === "object" && settings.pages ? settings.pages : {};
  return pages[key] === true;
}

/** Pages this user may switch on (entitlement only, ignores the toggle). */
export function entitledPages(isAdminUi) {
  return OPTIONAL_PAGES.filter((p) => isAdminUi || !p.adminOnly);
}

/** path → visible? Non-optional paths are always true (other gates still apply). */
export function isPathVisible(path, settings, isAdminUi) {
  const p = BY_PATH[path];
  if (!p) return true;
  return (isAdminUi || !p.adminOnly) && pageEnabled(settings, p.key);
}

export function usePageVisibility() {
  const { settings, loading } = useAppSettings();
  const { loaded, isAdminUi } = useEntitlements();
  return {
    ready: !loading && loaded,
    isVisible: (path) => isPathVisible(path, settings, isAdminUi),
  };
}
